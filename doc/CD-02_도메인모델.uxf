<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<diagram program="umlet" version="15.1">
<zoom_level>10</zoom_level>
<element>
<id>UMLClass</id>
<coordinates>
<x>20</x>
<y>20</y>
<w>530</w>
<h>200</h>
</coordinates>
<panel_attributes>&lt;&lt;entity&gt;&gt;
*Catalog*
--
-stars: Map&lt;String, Star&gt;
-bySystem: Map&lt;StarSystem, List&lt;Constellation&gt;&gt;
--
+Catalog(stars, constellations)
+star(id: String): Star
+hasStar(id: String): boolean
+stars(): Collection&lt;Star&gt;
+constellations(system: StarSystem): List&lt;Constellation&gt;
+constellations(system: StarSystem, difficulty: Difficulty): List&lt;Constellation&gt;
+constellation(system: StarSystem, id: String): Constellation</panel_attributes>
<additional_attributes></additional_attributes>
</element>
<element>
<id>UMLClass</id>
<coordinates>
<x>20</x>
<y>360</y>
<w>170</w>
<h>170</h>
</coordinates>
<panel_attributes>&lt;&lt;record&gt;&gt;
*Star*
--
id: String
properName: String
designation: String
raDeg: double
decDeg: double
magnitude: double
--
+displayName(): String</panel_attributes>
<additional_attributes></additional_attributes>
</element>
<element>
<id>UMLClass</id>
<coordinates>
<x>710</x>
<y>20</y>
<w>390</w>
<h>250</h>
</coordinates>
<panel_attributes>&lt;&lt;entity&gt;&gt;
*Constellation*
--
-id: String
-system: StarSystem
-name: String
-subtitle: String
-lines: Set&lt;Edge&gt; {readOnly}
-starIds: Set&lt;String&gt; {readOnly}
-difficulty: Difficulty
--
+Constellation(id, system, name, subtitle, lines, difficulty)
+contains(starId: String): boolean
+fullName(): String
+lines(): Set&lt;Edge&gt;
+starIds(): Set&lt;String&gt;</panel_attributes>
<additional_attributes></additional_attributes>
</element>
<element>
<id>UMLClass</id>
<coordinates>
<x>710</x>
<y>360</y>
<w>300</w>
<h>150</h>
</coordinates>
<panel_attributes>&lt;&lt;record&gt;&gt;
*Edge*
--
a: String
b: String
--
+Edge(a: String, b: String) {a &lt; b 로 정규화}
+touches(starId: String): boolean
+encode(): String
_+decode(text: String): Edge_</panel_attributes>
<additional_attributes></additional_attributes>
</element>
