<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<diagram program="umlet" version="15.1">
<zoom_level>10</zoom_level>
<element>
<id>UMLClass</id>
<coordinates>
<x>495</x>
<y>20</y>
<w>280</w>
<h>190</h>
</coordinates>
<panel_attributes>&lt;&lt;entity&gt;&gt;
*GameSession*
--
-mode: GameMode
-basic: BasicGame
-night: NightSkyGame
--
_+of(basic: BasicGame): GameSession_
_+of(night: NightSkyGame): GameSession_
+system(): StarSystem
+board(): EdgeBoard
+summary(): String</panel_attributes>
<additional_attributes></additional_attributes>
</element>
<element>
<id>UMLClass</id>
<coordinates>
<x>20</x>
<y>300</y>
<w>370</w>
<h>330</h>
</coordinates>
<panel_attributes>&lt;&lt;entity&gt;&gt;
*BasicGame*
--
-system: StarSystem
-difficulty: Difficulty
-order: List&lt;String&gt;
-index: int
-state: CompletionState
-hintsUsed: int
-solved: Set&lt;String&gt;
-revealed: Set&lt;String&gt;
--
_+start(catalog, system, difficulty, random): BasicGame_
_+restore(catalog, system, difficulty, order, index,_
_   edges, state, hintsUsed, solved, revealed): BasicGame_
+current(): Constellation
+editable(): boolean
+submit(): boolean
+hint(): HelpResult
+reveal(): boolean
+next(random: Random)</panel_attributes>
<additional_attributes></additional_attributes>
</element>
<element>
<id>UMLClass</id>
<coordinates>
<x>880</x>
<y>300</y>
<w>350</w>
<h>330</h>
</coordinates>
<panel_attributes>&lt;&lt;entity&gt;&gt;
*NightSkyGame*
--
-system: StarSystem
-states: Map&lt;String, CompletionState&gt;
-hints: Map&lt;String, Integer&gt;
-earned: Map&lt;String, Integer&gt;
-positions: Map&lt;String, Horizontal&gt;
--
+NightSkyGame(catalog, system, observation)
_+restore(catalog, system, observation,_
_   edges, states, hints, earned): NightSkyGame_
-computeSky()
+submit(): List&lt;Award&gt;
+hint(selectedStar: String): HelpResult
+revealTarget(selectedStar: String): Constellation
+reveal(c: Constellation): boolean
+state(c: Constellation): CompletionState
+hintsUsed(c: Constellation): int
+score(): int
+count(s: CompletionState): int</panel_attributes>
<additional_attributes></additional_attributes>
</element>
<element>
<id>UMLClass</id>
<coordinates>
<x>510</x>
<y>300</y>
<w>250</w>
<h>230</h>
</coordinates>
<panel_attributes>&lt;&lt;entity&gt;&gt;
*EdgeBoard*
--
-edges: Set&lt;Edge&gt;
-history: Deque&lt;Action&gt;
--
+add(e: Edge): boolean
+remove(e: Edge): boolean
+clear(): boolean
+undo(): boolean
+addFromHint(e: Edge)
+applyAnswer(wrong, answer)
+restore(saved: Collection&lt;Edge&gt;)
+contains(e: Edge): boolean
+edges(): Set&lt;Edge&gt;</panel_attributes>
<additional_attributes></additional_attributes>
</element>
<element>
<id>UMLClass</id>
<coordinates>
<x>435</x>
<y>720</y>
<w>400</w>
<h>130</h>
</coordinates>
<panel_attributes>&lt;&lt;utility&gt;&gt;
*AnswerJudge*
--
+exactMatch(user: Set&lt;Edge&gt;, c: Constellation): boolean
+completes(user: Set&lt;Edge&gt;, c: Constellation): boolean
+within(user: Set&lt;Edge&gt;, members: Set&lt;String&gt;): Set&lt;Edge&gt;
+correctCount(user: Set&lt;Edge&gt;, c: Constellation): int
+hintEdge(user: Set&lt;Edge&gt;, c: Constellation): Edge</panel_attributes>
<additional_attributes></additional_attributes>
</element>
<element>
<id>UMLClass</id>
<coordinates>
<x>20</x>
<y>720</y>
<w>230</w>
<h>120</h>
</coordinates>
<panel_attributes>&lt;&lt;record&gt;&gt;
*HelpResult*
--
status: Status
target: Constellation
edge: Edge
--
_+of(status: Status): HelpResult_</panel_attributes>
<additional_attributes></additional_attributes>
</element>
<element>
<id>UMLClass</id>
<coordinates>
<x>20</x>
<y>900</y>
<w>160</w>
<h>130</h>
</coordinates>
<panel_attributes>&lt;&lt;enumeration&gt;&gt;
*HelpResult.Status*
--
ADDED
ALREADY_USED
NO_TARGET
NOTHING_TO_ADD
FINISHED</panel_attributes>
<additional_attributes></additional_attributes>
</element>
